# Copy to backend/.env and fill in. Never commit real values.

# JWT signing key (required in production). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Set to "production" in deployed environments (Render is detected automatically via RENDER=true).
APP_ENV=development

# Optional: database URL. Defaults to local SQLite (backend/sql_app.db, git-ignored).
DATABASE_URL=

# Optional: used by services/ai_service.py
OPENAI_API_KEY=
